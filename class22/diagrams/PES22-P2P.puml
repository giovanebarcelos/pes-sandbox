@startuml PES22-P2P
' PES22 - Peer-to-Peer Architecture (Arquitetura Descentralizada)
' Aula 22: Microsserviços e Arquiteturas Distribuídas
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES22-P2P.mmd (Mermaid).

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #334155
skinparam rectangle {
  RoundCorner 12
}

node "Nó A\n(recurso + cliente)" as N1 #2563EB;text:white
node "Nó B\n(recurso + cliente)" as N2 #059669;text:white
node "Nó C\n(recurso + cliente)" as N3 #EA580C;text:white
node "Nó D\n(recurso + cliente)" as N4 #7C3AED;text:white
rectangle "Discovery Service\n(opcional, para bootstrap)" as DS #D97706;text:white

N1 <-right-> N2 : conexão direta
N2 <-down-> N3 : conexão direta
N3 <-left-> N4 : conexão direta
N4 <-up-> N1 : conexão direta
N1 <--> N3 : conexão direta
N2 <--> N4 : conexão direta

N1 ..> DS : registra/descobre
N2 ..> DS : registra/descobre
N3 ..> DS : registra/descobre
N4 ..> DS : registra/descobre
@enduml
