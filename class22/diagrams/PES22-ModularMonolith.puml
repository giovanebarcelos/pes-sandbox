@startuml PES22-ModularMonolith
' PES22 - Modular Monolith Architecture
' Aula 22: Microsserviços e Arquiteturas Distribuídas
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES22-ModularMonolith.mmd (Mermaid).

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #334155
skinparam rectangle {
  RoundCorner 12
}

rectangle "Modular Monolith\n(único deploy, múltiplos módulos)" as App #334155;text:white
component "Módulo Vendas\nAPI interna + DB schema" as M1 #2563EB;text:white
component "Módulo Estoque\nAPI interna + DB schema" as M2 #059669;text:white
component "Módulo Pagamento\nAPI interna + DB schema" as M3 #EA580C;text:white
component "Módulo Notificação\nAPI interna + DB schema" as M4 #7C3AED;text:white
database "Database Única\n(schemas isolados)" as DB #D97706;text:white

App --> M1
App --> M2
App --> M3
App --> M4
M1 --> M2 : chamada in-process
M1 --> M3 : chamada in-process
M3 --> M4 : chamada in-process
M1 -- DB
M2 -- DB
M3 -- DB
M4 -- DB
@enduml
