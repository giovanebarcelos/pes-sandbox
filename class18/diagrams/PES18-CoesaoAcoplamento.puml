@startuml PES18-CoesaoAcoplamento
' PES18 - Coesão e Acoplamento
' Aula 18: Princípios de Projeto e Padrões Arquiteturais
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES18-CoesaoAcoplamento.mmd (Mermaid).

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #334155
skinparam rectangle {
  RoundCorner 12
}
skinparam defaultTextAlignment left

rectangle "Alta Coesão" as AltaCoesao #059669;text:white {
  rectangle "Classe Pedido:\n• validar()\n• calcularTotal()\n• aplicarDesconto()" as C1 #FFFFFF
}
rectangle "Baixa Coesão" as BaixaCoesao #EF4444;text:white {
  rectangle "Classe God:\n• validarPedido()\n• enviarEmail()\n• gerarPDF()\n• logAuditoria()\n• calcularFrete()" as C2 #FFFFFF
}
rectangle "Baixo Acoplamento" as BaixoAcopl #059669;text:white {
  rectangle "PedidoService" as A1 #FFFFFF
  rectangle "EstoqueRepository" as B1 #FFFFFF
}
rectangle "Alto Acoplamento" as AltoAcopl #EF4444;text:white {
  rectangle "PedidoService" as A2 #FFFFFF
  rectangle "MySQL conexão" as B2 #FFFFFF
}

A1 ..> B1 : interface
A2 --> B2 : dependência direta
AltaCoesao -[hidden]right- BaixaCoesao
BaixoAcopl -[hidden]right- AltoAcopl
@enduml
