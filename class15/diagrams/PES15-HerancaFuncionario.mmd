%% Versão PlantUML nativa: PES15-HerancaFuncionario.puml (mesma pasta) — https://plantuml.com/
classDiagram
    class Funcionario {
        <<abstract>>
        -String nome
        -double salarioBase
        +getNome() String
        +getSalarioBase() double
        +calcularSalario()* double
    }
    class Desenvolvedor {
        -String linguagem
        +calcularSalario() double
    }
    class Gerente {
        -double bonus
        +calcularSalario() double
    }
    Funcionario <|-- Desenvolvedor
    Funcionario <|-- Gerente
