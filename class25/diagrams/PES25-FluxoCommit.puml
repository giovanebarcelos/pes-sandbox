@startuml PES25-FluxoCommit
' PES25 - Fluxo de Trabalho com Commits
' Aula 25: Gerência de Configuração e Introdução ao Git
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES25-FluxoCommit.mmd (Mermaid).

skinparam shadowing false
skinparam ArrowColor #334155

start
#2563EB:<color:#FFF>git init / clone</color>;
repeat
  :Editar arquivos;
  :git add;
  #059669:<color:#FFF>git commit -m 'mensagem'</color>;
repeat while (Mais mudanças?) is (Sim) not (Não)
#7C3AED:<color:#FFF>git push</color>;
:git log;
:Colaborar: pull request;
stop
@enduml
