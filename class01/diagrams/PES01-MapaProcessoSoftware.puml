@startuml PES01-MapaProcessoSoftware
' PES01 - Mapa do Processo de Software
' Aula 01: Boas-vindas e Introdução à Engenharia de Software
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES01-MapaProcessoSoftware.mmd (Mermaid).

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #334155
skinparam rectangle {
  RoundCorner 12
}

rectangle "Necessidade do Cliente" as A #2563EB;text:white
rectangle "Requisitos" as B #EA580C;text:white
rectangle "Projeto (Design)" as C #7C3AED;text:white
rectangle "Implementação" as D #059669;text:white
rectangle "Testes" as E #D97706;text:white
rectangle "Entrega / Implantação" as F #2563EB;text:white
rectangle "Manutenção" as G #334155;text:white

A --> B
B --> C
C --> D
D --> E
E --> F
F --> G
G --> B
@enduml
