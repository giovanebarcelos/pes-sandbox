@startuml PES21-DDD-Contextos
' PES21 - DDD: Bounded Contexts (Contextos Delimitados)
' Aula 21: DDD, CQRS e Event Sourcing
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES21-DDD-Contextos.mmd (Mermaid).

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #334155
skinparam rectangle {
  RoundCorner 12
}

rectangle "Contexto: Vendas" as Vendas #2563EB;text:white {
  rectangle "Pedido (Agregado)" as V1 #FFFFFF
  rectangle "ItemPedido (Entidade)" as V2 #FFFFFF
  rectangle "ClienteId (Value Object)" as V3 #FFFFFF
}
rectangle "Contexto: Estoque" as Estoque #059669;text:white {
  rectangle "Produto (Agregado)" as E1 #FFFFFF
  rectangle "Quantidade (Value Object)" as E2 #FFFFFF
}
rectangle "Contexto: Pagamento" as Pagamento #7C3AED;text:white {
  rectangle "Transacao (Agregado)" as P1 #FFFFFF
  rectangle "StatusPagamento (Value Object)" as P2 #FFFFFF
}

Vendas --> Estoque : eventos de domínio
Vendas --> Pagamento : eventos de domínio
@enduml
