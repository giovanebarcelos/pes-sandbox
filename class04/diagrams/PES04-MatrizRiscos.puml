@startuml PES04-MatrizRiscos
' PES04 - Matriz de Riscos (Probabilidade × Impacto)
' Aula 04: Acompanhamento, Riscos e Ferramentas de Gestão
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES04-MatrizRiscos.mmd (Mermaid).

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #334155
skinparam rectangle {
  RoundCorner 12
}

rectangle "Alta Probabilidade" as AltaProb #EF4444;text:white {
  rectangle "Atraso em dependência externa\n(P=0.7, I=Alto)" as A1 #FFFFFF
  rectangle "Mitigar: contrato com SLA" as R1 #FFFFFF
  rectangle "Saída de desenvolvedor chave\n(P=0.5, I=Alto)" as A2 #FFFFFF
  rectangle "Mitigar: documentação +\npair programming" as R2 #FFFFFF
}

rectangle "Média Probabilidade" as MediaProb #D97706;text:white {
  rectangle "Mudança de requisitos tardia\n(P=0.4, I=Médio)" as B1 #FFFFFF
  rectangle "Aceitar: reserva de contingência" as R3 #FFFFFF
  rectangle "Falha de integração\n(P=0.3, I=Alto)" as B2 #FFFFFF
  rectangle "Mitigar: CI/CD +\ntestes automatizados" as R4 #FFFFFF
}

rectangle "Baixa Probabilidade" as BaixaProb #059669;text:white {
  rectangle "Indisponibilidade de servidor\n(P=0.1, I=Baixo)" as C1 #FFFFFF
  rectangle "Aceitar: monitoramento" as R5 #FFFFFF
}

A1 --> R1
A2 --> R2
B1 --> R3
B2 --> R4
C1 --> R5
AltaProb -[hidden]-> MediaProb
MediaProb -[hidden]-> BaixaProb
@enduml
