@startuml PES25B-CamadasTestes
' PES25B - Camadas de teste no pipeline (fail fast: rápidos primeiro, lentos depois)
' Aula 25B (complementar): Integração Contínua e Entrega Contínua
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES25B-CamadasTestes.mmd (Mermaid).

skinparam shadowing false
skinparam ArrowColor #334155

start
:Commit;
if (Testes unitários (~1-2 min)?) then (passou)
  if (Testes de integração (~5 min)?) then (passou)
    if (Análise estática + Quality Gate (~3 min)?) then (aprovado)
      :Imagem Docker;
      :Deploy em staging;
      if (Testes de API / E2E (~15 min)?) then (passou)
        :Performance (só em releases);
        #059669:<color:#FFF>Deploy em produção</color>;
        stop
      endif
    endif
  endif
endif
#EF4444:<color:#FFF>Pipeline para: feedback em minutos</color>;
stop
@enduml
