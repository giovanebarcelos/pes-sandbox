@startuml PES20-CleanArch
' PES20 - Clean Architecture (Círculos Concêntricos)
' Aula 20: Clean Architecture, Hexagonal e Onion
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES20-CleanArch.mmd (Mermaid).

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #334155
skinparam rectangle {
  RoundCorner 12
}

rectangle "Frameworks" as Ext #64748B;text:white {
  rectangle "Web, DB, UI\n(detalhes)" as EX #FFFFFF
}
rectangle "Adaptadores" as Adapters #2563EB;text:white {
  rectangle "Controllers,\nGateways,\nPresenters" as AD #FFFFFF
}
rectangle "Casos de Uso" as UC #D97706;text:white {
  rectangle "Orquestração do\ndomínio" as U #FFFFFF
}
rectangle "Entidades (Domínio)" as Core #EF4444;text:white {
  rectangle "Regras de negócio\nmais abstratas" as E #FFFFFF
}

Ext --> Adapters
Adapters --> UC
UC --> Core

note right of Core
  Regra da dependência:
  as setas apontam sempre
  para dentro (o domínio)
end note
@enduml
