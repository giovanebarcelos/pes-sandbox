@startuml PES20-Hexagonal
' PES20 - Arquitetura Hexagonal (Ports & Adapters)
' Aula 20: Clean Architecture, Hexagonal e Onion
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES20-Hexagonal.mmd (Mermaid).

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #334155
skinparam rectangle {
  RoundCorner 12
}
left to right direction

rectangle "Primários (Driving)" as Primary #2563EB;text:white {
  rectangle "REST API" as P1 #FFFFFF
  rectangle "CLI" as P2 #FFFFFF
  rectangle "Testes" as P3 #FFFFFF
}
rectangle "Domínio (Core)" as Core #7C3AED;text:white {
  rectangle "Portas\n(Interfaces)" as C1 #FFFFFF
  rectangle "Lógica de\nNegócio" as C2 #FFFFFF
}
rectangle "Secundários (Driven)" as Secondary #059669;text:white {
  database "MySQL" as S1 #FFFFFF
  database "MongoDB" as S2 #FFFFFF
  rectangle "API Externa" as S3 #FFFFFF
}

Primary --> Core : usa
Core --> Secondary : implementa
@enduml
