@startuml PES27-C4-Contexto
' PES27 - Diagrama C4: Contexto do Sistema
' Aula 27: Documentação Técnica e Projeto Integrador Final
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES27-C4-Contexto.mmd (Mermaid).

!include <C4/C4_Context>

LAYOUT_TOP_DOWN()

Person(User, "Usuário", "Cliente da Locadora")
Person(Admin, "Administrador", "Funcionário")
System(Sistema, "Sistema Locadora", "Software a ser construído")
System_Ext(Email, "Serviço de Email", "Sistema externo")
System_Ext(Pagamento, "Gateway de Pagamento", "Sistema externo")

Rel(User, Sistema, "Usa")
Rel(Admin, Sistema, "Administra")
Rel(Sistema, Email, "Envia e-mails")
Rel(Sistema, Pagamento, "Processa pagamentos")

SHOW_LEGEND()
@enduml
