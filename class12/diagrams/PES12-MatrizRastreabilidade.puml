@startuml PES12-MatrizRastreabilidade
' PES12 - Matriz de Rastreabilidade Requisitos × Casos de Uso
' Aula 12: Documentação e Validação de Requisitos
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES12-MatrizRastreabilidade.mmd (Mermaid).

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #334155
skinparam rectangle {
  RoundCorner 12
}
left to right direction

rectangle "RF01: Login" as RF1 #2563EB;text:white
rectangle "RF02: Buscar produtos" as RF2 #2563EB;text:white
rectangle "RF03: Realizar pedido" as RF3 #2563EB;text:white
rectangle "RNF01: Tempo < 2s" as RNF1 #EA580C;text:white
rectangle "UC01: Autenticar usuário" as UC1 #059669;text:white
rectangle "UC02: Buscar produtos" as UC2 #059669;text:white
rectangle "UC03: Criar pedido" as UC3 #059669;text:white
rectangle "UC04: Processar pagamento" as UC4 #059669;text:white

RF1 --> UC1
RF2 --> UC2
RF3 --> UC3
RF3 --> UC4
RNF1 --> UC1
RNF1 --> UC2
RNF1 --> UC3
@enduml
