@startuml PES02-CicloVidaProjeto
' PES02 - Ciclo de Vida do Projeto
' Aula 02: Fundamentos de Gerenciamento de Projetos
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES02-CicloVidaProjeto.mmd (Mermaid).

skinparam shadowing false
skinparam ArrowColor #334155

start
#2563EB:<color:#FFF>Termo de Abertura</color>;
#EA580C:<color:#FFF>Planejamento Detalhado</color>;
repeat
  #059669:<color:#FFF>Execução das Atividades</color>;
  #7C3AED:<color:#FFF>Entrega Parcial</color>;
repeat while (Mais entregas?) is (Sim) not (Não)
#059669:<color:#FFF>Entrega Final</color>;
:Lições Aprendidas;
#334155:<color:#FFF>Encerramento</color>;
stop
@enduml
