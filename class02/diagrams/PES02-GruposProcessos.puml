@startuml PES02-GruposProcessos
' PES02 - Grupos de Processos do Gerenciamento de Projetos
' Aula 02: Fundamentos de Gerenciamento de Projetos
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES02-GruposProcessos.mmd (Mermaid).

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #334155
skinparam rectangle {
  RoundCorner 12
}
left to right direction

rectangle "Iniciação" as A #2563EB;text:white
rectangle "Planejamento" as B #EA580C;text:white
rectangle "Execução" as C #059669;text:white
rectangle "Monitoramento e Controle" as D #D97706;text:white
rectangle "Encerramento" as E #7C3AED;text:white

A --> B
B --> C
C --> D
D --> B
D --> C
C --> E
@enduml
