@startuml PES26-GitFlow
' PES26 - Git Flow
' Aula 26: Fluxos de Trabalho com Git e Colaboração
' Projeto e Engenharia de Software - Prof. Giovane Barcelos
' Versão PlantUML (https://plantuml.com/) do diagrama PES26-GitFlow.mmd (Mermaid).

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #334155
skinparam rectangle {
  RoundCorner 12
}

rectangle "main (produção)" as M #059669;text:white
rectangle "develop" as D #2563EB;text:white
rectangle "feature/login" as F1 #EA580C;text:white
rectangle "feature/pagamento" as F2 #EA580C;text:white
rectangle "release/v1.0" as R #7C3AED;text:white
rectangle "hotfix/bug-critico" as HF #EF4444;text:white

M --> D
D --> F1
D --> F2
F1 --> D
F2 --> D
D --> R
R --> M
M --> HF
HF --> M
HF --> D
@enduml
